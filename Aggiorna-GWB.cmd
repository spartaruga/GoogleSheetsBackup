@echo off
setlocal
set "GWB_BOOTSTRAP_FILE=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:GWB_BOOTSTRAP_FILE);$b=$s.Substring($s.LastIndexOf('# GWB_PAYLOAD_BEGIN')+19).Trim();& ([ScriptBlock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b))))"
if errorlevel 1 pause
exit /b
# GWB_PAYLOAD_BEGIN

